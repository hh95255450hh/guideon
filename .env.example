PORT=3000
NODE_ENV=development

# ── Supabase (required) ──────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_STORAGE_BUCKET=media
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ── Session (required) ────────────────────────────────────────────────────────
SESSION_SECRET=change_this_to_random_32_plus_chars

# ── Stripe (required for payments) ────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE

# ── Resend (required for emails) ──────────────────────────────────────────────
RESEND_API_KEY=re_REPLACE
# Domain guideon.guide is verified in Resend — use the official sender:
EMAIL_FROM="Guideon <noreply@guideon.guide>"
# Replies (when user clicks Reply) go to info@guideon.guide via Cloudflare Routing:
EMAIL_REPLY_TO="info@guideon.guide"
# Logo shown at the top of every transactional email (public URL):
EMAIL_LOGO_URL="https://guideon.guide/logo.png"
# Where contact-form submissions land (default = info@guideon.guide):
CONTACT_INBOX=info@guideon.guide
ADMIN_EMAIL=Hh95255450hh@hotmail.com

# ── Payments toggle (off during free launch period) ───────────────────────────
# Set to "true" to enable Stripe checkout once you're ready to charge.
PAYMENTS_ENABLED=false

# ── Sessions ──────────────────────────────────────────────────────────────────
# Use Postgres-backed sessions in production (survives restarts).
# Leave false locally to use in-memory store.
USE_PG_SESSIONS=false

# ── OpenAI (optional — local KB fallback if missing) ──────────────────────────
OPENAI_API_KEY=sk-proj-REPLACE

# ── Firebase (optional — for push notifications) ──────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_VAPID_KEY=
FIREBASE_PRIVATE_KEY=""

# ── Sentry (optional but recommended) ─────────────────────────────────────────
SENTRY_DSN=

# ── App URLs ──────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,https://guideon.om,https://www.guideon.om

# ── WhatsApp Notifications (Meta Cloud API) ──────────────────────────────────
# Free tier: 1,000 conversations/month. Set up at developers.facebook.com.
# Leave ENABLED=false (default) to skip WhatsApp — site still works normally.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Rate Limiting (all optional — sensible defaults baked in) ─────────────────
# Set RATE_LIMIT_DISABLED=true to bypass ALL limits (useful during a launch
# promotion or while debugging). Default = enabled.
# RATE_LIMIT_DISABLED=false

# Registration: 20 accounts / 60 min / IP. Raise during marketing pushes.
# RATE_LIMIT_REGISTER_MAX=50
# RATE_LIMIT_REGISTER_WINDOW_MIN=60

# Login: 20 attempts / 15 min / IP (only failed attempts count).
# RATE_LIMIT_LOGIN_MAX=20
# RATE_LIMIT_LOGIN_WINDOW_MIN=15

# Password reset emails: 10 / 60 min / IP.
# RATE_LIMIT_RESET_MAX=10
# RATE_LIMIT_RESET_WINDOW_MIN=60

# General API: 100 requests / 60 sec / IP.
# RATE_LIMIT_API_MAX=100
# RATE_LIMIT_API_WINDOW_SEC=60

# Chatbot: 20 messages / 60 sec / IP.
# RATE_LIMIT_CHAT_MAX=20
# RATE_LIMIT_CHAT_WINDOW_SEC=60
