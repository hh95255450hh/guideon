{
  "info": {
    "name": "OmanExplorer API",
    "description": "Complete API collection for OmanExplorer Tourism Marketplace.\n\n## Setup\n1. Import this collection in Postman\n2. Set `base_url` variable to `http://localhost:3000` (already set)\n3. Run **Login** request — tokens save automatically\n4. All protected requests use the saved token automatically\n\n## Collection Variables\n- `base_url` — server address\n- `access_token` — auto-saved on login/register\n- `refresh_token` — auto-saved on login/register\n- `tour_id` — copy from any tour response\n- `availability_id` — copy from tour availability response\n- `booking_id` — auto-saved on create booking\n- `company_id` — copy from companies response\n- `review_id` — copy from review response\n- `user_id` — copy from admin users list",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",        "value": "http://localhost:3000" },
    { "key": "access_token",    "value": "" },
    { "key": "refresh_token",   "value": "" },
    { "key": "tour_id",         "value": "" },
    { "key": "availability_id", "value": "" },
    { "key": "booking_id",      "value": "" },
    { "key": "company_id",      "value": "" },
    { "key": "review_id",       "value": "" },
    { "key": "user_id",         "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [

    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
          }
        },
        {
          "name": "API Overview",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/api", "host": ["{{base_url}}"], "path": ["api"] }
          }
        }
      ]
    },

    {
      "name": "Auth",
      "item": [
        {
          "name": "Register — Tourist",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 201) {",
              "  const r = pm.response.json();",
              "  pm.collectionVariables.set('access_token',  r.data.accessToken);",
              "  pm.collectionVariables.set('refresh_token', r.data.refreshToken);",
              "  console.log('Tokens saved');",
              "}"
            ]}
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ahmed Al-Balushi\",\n  \"email\": \"ahmed@test.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"tourist\",\n  \"phone\": \"+96890000001\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api","auth","register"] }
          }
        },
        {
          "name": "Register — Company",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 201) {",
              "  const r = pm.response.json();",
              "  pm.collectionVariables.set('access_token',  r.data.accessToken);",
              "  pm.collectionVariables.set('refresh_token', r.data.refreshToken);",
              "}"
            ]}
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Muscat Adventures\",\n  \"email\": \"info@muscatadv.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"company\",\n  \"phone\": \"+96891000001\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api","auth","register"] }
          }
        },
        {
          "name": "Login — Tourist (seed)",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 200) {",
              "  const r = pm.response.json();",
              "  pm.collectionVariables.set('access_token',  r.data.accessToken);",
              "  pm.collectionVariables.set('refresh_token', r.data.refreshToken);",
              "  console.log('Logged in as tourist, tokens saved');",
              "}"
            ]}
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tourist@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api","auth","login"] }
          }
        },
        {
          "name": "Login — Company (seed)",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 200) {",
              "  const r = pm.response.json();",
              "  pm.collectionVariables.set('access_token',  r.data.accessToken);",
              "  pm.collectionVariables.set('refresh_token', r.data.refreshToken);",
              "  console.log('Logged in as company, tokens saved');",
              "}"
            ]}
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"company@muscatadventures.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api","auth","login"] }
          }
        },
        {
          "name": "Login — Admin (seed)",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 200) {",
              "  const r = pm.response.json();",
              "  pm.collectionVariables.set('access_token',  r.data.accessToken);",
              "  pm.collectionVariables.set('refresh_token', r.data.refreshToken);",
              "  console.log('Logged in as admin, tokens saved');",
              "}"
            ]}
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@omanexplorer.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api","auth","login"] }
          }
        },
        {
          "name": "Get Current User (/me)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/auth/me", "host": ["{{base_url}}"], "path": ["api","auth","me"] }
          }
        },
        {
          "name": "Refresh Token",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 200) {",
              "  const r = pm.response.json();",
              "  pm.collectionVariables.set('access_token',  r.data.accessToken);",
              "  pm.collectionVariables.set('refresh_token', r.data.refreshToken);",
              "}"
            ]}
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/refresh", "host": ["{{base_url}}"], "path": ["api","auth","refresh"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/api/auth/logout", "host": ["{{base_url}}"], "path": ["api","auth","logout"] }
          }
        },
        {
          "name": "Login — Wrong Password (expect 401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tourist@example.com\",\n  \"password\": \"WrongPassword\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api","auth","login"] }
          }
        },
        {
          "name": "Register — Weak Password (expect 422)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test\",\n  \"email\": \"test@test.com\",\n  \"password\": \"weak\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api","auth","register"] }
          }
        }
      ]
    },

    {
      "name": "Tours",
      "item": [
        {
          "name": "List Tours (public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/tours?page=1&limit=12",
              "host": ["{{base_url}}"], "path": ["api","tours"],
              "query": [
                { "key": "page",      "value": "1" },
                { "key": "limit",     "value": "12" },
                { "key": "category",  "value": "",  "disabled": true },
                { "key": "region",    "value": "",  "disabled": true },
                { "key": "minPrice",  "value": "",  "disabled": true },
                { "key": "maxPrice",  "value": "",  "disabled": true },
                { "key": "difficulty","value": "",  "disabled": true },
                { "key": "minRating", "value": "",  "disabled": true },
                { "key": "search",    "value": "",  "disabled": true },
                { "key": "sortBy",    "value": "created_at", "disabled": true },
                { "key": "sortOrder", "value": "DESC",       "disabled": true }
              ]
            }
          }
        },
        {
          "name": "List Tours — Filter by Category",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/tours?category=Desert&sortBy=price&sortOrder=ASC",
              "host": ["{{base_url}}"], "path": ["api","tours"],
              "query": [
                { "key": "category",  "value": "Desert" },
                { "key": "sortBy",    "value": "price" },
                { "key": "sortOrder", "value": "ASC" }
              ]
            }
          }
        },
        {
          "name": "List Tours — Search",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/tours?search=wadi",
              "host": ["{{base_url}}"], "path": ["api","tours"],
              "query": [{ "key": "search", "value": "wadi" }]
            }
          }
        },
        {
          "name": "Get Tour by ID",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/tours/{{tour_id}}", "host": ["{{base_url}}"], "path": ["api","tours","{{tour_id}}"] }
          }
        },
        {
          "name": "Get Tour Availability",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/tours/{{tour_id}}/availability", "host": ["{{base_url}}"], "path": ["api","tours","{{tour_id}}","availability"] }
          }
        },
        {
          "name": "Get Tour Reviews",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/tours/{{tour_id}}/reviews", "host": ["{{base_url}}"], "path": ["api","tours","{{tour_id}}","reviews"] }
          }
        },
        {
          "name": "Create Tour [company/admin]",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 201) {",
              "  const r = pm.response.json();",
              "  pm.collectionVariables.set('tour_id', r.data.tour.id);",
              "  console.log('tour_id saved:', r.data.tour.id);",
              "}"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Wahiba Sands Desert Safari\",\n  \"description\": \"Two-day desert adventure through the golden dunes of Wahiba Sands. Includes camel riding, dune bashing, and stargazing.\",\n  \"location\": \"Wahiba Sands\",\n  \"region\": \"Al Sharqiyah\",\n  \"price\": 150.00,\n  \"duration_days\": 2,\n  \"max_participants\": 12,\n  \"category\": \"Desert\",\n  \"difficulty\": \"moderate\",\n  \"includes\": [\"Transport\", \"Meals\", \"Accommodation\", \"Guide\"],\n  \"excludes\": [\"Travel insurance\", \"Personal items\", \"Tips\"],\n  \"meeting_point\": \"Muscat Grand Mall Parking\",\n  \"availability\": [\n    { \"date\": \"2026-07-01\", \"available_spots\": 12 },\n    { \"date\": \"2026-07-15\", \"available_spots\": 12 },\n    { \"date\": \"2026-08-01\", \"available_spots\": 12 }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/api/tours", "host": ["{{base_url}}"], "path": ["api","tours"] }
          }
        },
        {
          "name": "Update Tour [company/admin]",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 165.00,\n  \"max_participants\": 15,\n  \"status\": \"active\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/tours/{{tour_id}}", "host": ["{{base_url}}"], "path": ["api","tours","{{tour_id}}"] }
          }
        },
        {
          "name": "Add Tour Image — URL [company/admin]",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com/images/wahiba-sands.jpg\",\n  \"is_primary\": true\n}"
            },
            "url": { "raw": "{{base_url}}/api/tours/{{tour_id}}/images", "host": ["{{base_url}}"], "path": ["api","tours","{{tour_id}}","images"] }
          }
        },
        {
          "name": "Add Tour Image — File Upload [company/admin]",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "image", "type": "file", "src": "" },
                { "key": "is_primary", "value": "false", "type": "text" }
              ]
            },
            "url": { "raw": "{{base_url}}/api/tours/{{tour_id}}/images", "host": ["{{base_url}}"], "path": ["api","tours","{{tour_id}}","images"] }
          }
        },
        {
          "name": "Add Availability [company/admin]",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 201) {",
              "  const r = pm.response.json();",
              "  if (r.data && r.data.availability && r.data.availability[0]) {",
              "    pm.collectionVariables.set('availability_id', r.data.availability[0].id);",
              "    console.log('availability_id saved');",
              "  }",
              "}"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"availability\": [\n    { \"date\": \"2026-09-10\", \"available_spots\": 10 },\n    { \"date\": \"2026-09-20\", \"available_spots\": 8 }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/api/tours/{{tour_id}}/availability", "host": ["{{base_url}}"], "path": ["api","tours","{{tour_id}}","availability"] }
          }
        },
        {
          "name": "Update Availability Spots [company/admin]",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"available_spots\": 6\n}"
            },
            "url": { "raw": "{{base_url}}/api/tours/{{tour_id}}/availability/{{availability_id}}", "host": ["{{base_url}}"], "path": ["api","tours","{{tour_id}}","availability","{{availability_id}}"] }
          }
        },
        {
          "name": "Delete Availability [company/admin]",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/api/tours/{{tour_id}}/availability/{{availability_id}}", "host": ["{{base_url}}"], "path": ["api","tours","{{tour_id}}","availability","{{availability_id}}"] }
          }
        },
        {
          "name": "Delete Tour [admin only]",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/api/tours/{{tour_id}}", "host": ["{{base_url}}"], "path": ["api","tours","{{tour_id}}"] }
          }
        }
      ]
    },

