# ── Guideon production environment (Oman Data Park) ─────────────────────────
# Copy to deploy/.env and fill in real values. NEVER commit the filled .env.

NODE_ENV=production
PORT=3000
APP_URL=https://guideon.om
PUBLIC_URL=https://guideon.om

# ── Data layer: SELF-HOSTED Supabase on this server ─────────────────────────
# Point to the local self-hosted Supabase stack (see MIGRATION-GUIDE.md §3).
# These keys come from the self-hosted Supabase .env (ANON_KEY / SERVICE_ROLE_KEY).
SUPABASE_URL=http://host.docker.internal:8000
SUPABASE_SERVICE_ROLE_KEY=__SELF_HOSTED_SERVICE_ROLE_KEY__
SUPABASE_ANON_KEY=__SELF_HOSTED_ANON_KEY__
SUPABASE_STORAGE_BUCKET=media

# ── Sessions ────────────────────────────────────────────────────────────────
SESSION_SECRET=__GENERATE_A_LONG_RANDOM_STRING__
INVOICE_SECRET=__ANOTHER_LONG_RANDOM_STRING__

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=__YOUR_RESEND_KEY__
EMAIL_FROM=Guideon <noreply@guideon.om>
EMAIL_REPLY_TO=hh92hh@guideon.om
ADMIN_EMAIL=hh92hh@guideon.om

# ── Payments (Thawani) ──────────────────────────────────────────────────────
PAYMENTS_ENABLED=false
THAWANI_MODE=uat
THAWANI_API_KEY=
THAWANI_PUBLISHABLE_KEY=

# ── AI (optional — Claude) ──────────────────────────────────────────────────
# Leave empty to disable AI features; the platform works without them.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ── Misc ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
LOG_LEVEL=info
CORS_ORIGINS=https://guideon.om,https://www.guideon.om
